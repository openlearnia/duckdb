# name: test/sql/catalog/procedure_sql_api.test
# description: JavaScript stored procedures can run SQL through the injected duckdb helper

# ---------------------------------------------------------------- query(): reads

statement ok
CREATE TABLE inventory(item VARCHAR, qty INTEGER);

statement ok
INSERT INTO inventory VALUES ('apple', 5), ('banana', 8);

statement ok
CREATE PROCEDURE top_item()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
AS $$
  const rows = duckdb.query('SELECT item, qty FROM inventory ORDER BY qty DESC');
  if (!Array.isArray(rows)) { throw new Error('query did not return an array'); }
  if (rows.length !== 2) { throw new Error('expected 2 rows, got ' + rows.length); }
  return JSON.stringify(rows[0]);
$$;

query T
CALL top_item();
----
{"item":"banana","qty":8}

# NULL cells are exposed as null

statement ok
CREATE TABLE notes(id INTEGER, body VARCHAR);

statement ok
INSERT INTO notes VALUES (1, 'hello'), (2, NULL);

statement ok
CREATE PROCEDURE dump_notes()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
AS $$
  return JSON.stringify(duckdb.query('SELECT id, body FROM notes ORDER BY id'));
$$;

query T
CALL dump_notes();
----
[{"id":1,"body":"hello"},{"id":2,"body":null}]

# various SQL types round-trip into predictable JavaScript shapes

statement ok
CREATE TABLE events(d DATE, flag BOOLEAN, score DOUBLE, tag UBIGINT);

statement ok
CREATE PROCEDURE first_event()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
AS $$
  duckdb.execute("INSERT INTO events VALUES ('2026-01-15', TRUE, 9.5, 18446744073709551615)");
  const rows = duckdb.query('SELECT d, flag, score, tag FROM events ORDER BY d');
  return JSON.stringify(rows[0]);
$$;

query T
CALL first_event();
----
{"d":"2026-01-15","flag":true,"score":9.5,"tag":18446744073709552000}

# ------------------------------------------------------------- execute(): writes

# writes made through the helper commit immediately and are visible both inside the
# body (via later statements) and to the caller afterwards

statement ok
CREATE PROCEDURE add_stock(item VARCHAR, amount INTEGER)
RETURNS INTEGER
LANGUAGE JAVASCRIPT
AS $$
  duckdb.execute('INSERT INTO inventory VALUES ($1, $2)', [item, amount]);
  const rows = duckdb.query('SELECT count(*) AS n FROM inventory');
  return Number(rows[0].n);
$$;

query I
CALL add_stock('cherry', 3);
----
3

query I
SELECT sum(qty) FROM inventory;
----
16

# parameter bindings cast across types like ordinary SQL parameters

statement ok
CREATE PROCEDURE log_event(day VARCHAR, score DOUBLE)
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
AS $$
  duckdb.execute('INSERT INTO events VALUES ($1, FALSE, $2, 42)', [day, score]);
  const rows = duckdb.query('SELECT d, score FROM events ORDER BY d DESC LIMIT 1');
  return JSON.stringify(rows[0]);
$$;

query T
CALL log_event('2026-02-20', 2.25);
----
{"d":"2026-02-20","score":2.25}

# null parameters bind cleanly

statement ok
CREATE PROCEDURE add_anonymous_note()
RETURNS INTEGER
LANGUAGE JAVASCRIPT
AS $$
  duckdb.execute('INSERT INTO notes VALUES ($1, $2)', [99, null]);
  return 99;
$$;

query I
CALL add_anonymous_note();
----
99

query T
SELECT body FROM notes WHERE id = 99;
----
NULL

# execute() accepts multiple statements in one call

statement ok
CREATE PROCEDURE replace_notes()
RETURNS INTEGER
LANGUAGE JAVASCRIPT
AS $$
  duckdb.execute("DELETE FROM notes; INSERT INTO notes VALUES (7, 'replaced')");
  return 7;
$$;

query I
CALL replace_notes();
----
7

query T
SELECT body FROM notes;
----
replaced

# --------------------------------------------------------------- error propagation

# SQL errors surface as catchable JavaScript errors

statement ok
CREATE PROCEDURE sql_error_name()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
AS $$
  try {
    duckdb.execute('SELECT * FROM no_such_table_xyz');
  } catch (e) {
    return String(e.message).includes('no_such_table_xyz') ? 'sql error surfaced' : ('unexpected: ' + e.message);
  }
  return 'no error raised';
$$;

query T
CALL sql_error_name();
----
sql error surfaced

# unconsumed SQL errors abort the CALL

statement ok
CREATE PROCEDURE broken()
RETURNS INTEGER
LANGUAGE JAVASCRIPT
AS $$
  duckdb.execute('SELECT * FROM also_missing');
  return 0;
$$;

statement error
CALL broken();
----
also_missing

# invalid SQL fails too

statement ok
CREATE PROCEDURE syntax_error()
RETURNS INTEGER
LANGUAGE JAVASCRIPT
AS $$
  duckdb.execute('NOT VALID SQL AT ALL');
  return 0;
$$;

statement error
CALL syntax_error();
----
syntax error at or near

# ----------------------------------------------------------- argument validation

statement ok
CREATE PROCEDURE bad_params()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
AS $$
  try {
    duckdb.query('SELECT 42', 7);
  } catch (e) {
    return String(e.message).includes('must be an array') ? 'type error surfaced' : ('unexpected: ' + e.message);
  }
  return 'no error raised';
$$;

query T
CALL bad_params();
----
type error surfaced

statement ok
CREATE PROCEDURE bad_params_execute()
RETURNS VARCHAR
LANGUAGE JAVASCRIPT
AS $$
  try {
    duckdb.execute();
  } catch (e) {
    return String(e.message).startsWith('duckdb.execute expects a SQL string') ? 'type error surfaced'
                                                                                    : ('unexpected: ' + e.message);
  }
  return 'no error raised';
$$;

query T
CALL bad_params_execute();
----
type error surfaced

# ------------------------------------------------------------- recursion guard

# a procedure invoking itself through SQL is cut off instead of blowing the stack

statement ok
CREATE PROCEDURE recurse(n INTEGER)
RETURNS INTEGER
LANGUAGE JAVASCRIPT
AS $$
  duckdb.execute('CALL recurse(0)');
  return n;
$$;

statement error
CALL recurse(3);
----
nesting limit exceeded

# still sane afterwards

query I
SELECT 1 AS one;
----
1
