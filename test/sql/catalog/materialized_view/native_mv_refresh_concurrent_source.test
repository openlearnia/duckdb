# name: test/sql/catalog/materialized_view/native_mv_refresh_concurrent_source.test
# description: A refresh on an older source snapshot cannot capture a concurrent writer as fresh
# group: [materialized_view]

statement ok con1
CREATE TABLE source(v INTEGER)

statement ok con1
INSERT INTO source VALUES (10)

statement ok con1
CREATE MATERIALIZED VIEW mv AS SELECT v FROM source

statement ok con1
BEGIN

query I con1
SELECT * FROM source
----
10

statement ok con2
UPDATE source SET v=30

statement ok con1
REFRESH MATERIALIZED VIEW mv

query I con1
SELECT CAST(is_stale AS INTEGER) FROM duckdb_materialized_views() WHERE view_name='mv'
----
1

statement ok con1
COMMIT

query I con1
SELECT CAST(is_stale AS INTEGER) FROM duckdb_materialized_views() WHERE view_name='mv'
----
1

statement ok con1
REFRESH MATERIALIZED VIEW IF STALE mv

query I con1
SELECT * FROM mv
----
30

statement ok con2
BEGIN

statement ok con2
UPDATE source SET v=40

statement ok con2
ROLLBACK

query II con1
SELECT v, CAST((SELECT is_stale FROM duckdb_materialized_views() WHERE view_name='mv') AS INTEGER) FROM mv
----
30	0
