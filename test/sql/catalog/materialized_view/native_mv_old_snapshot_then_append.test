# name: test/sql/catalog/materialized_view/native_mv_old_snapshot_then_append.test
# description: A later append cannot incrementally refresh a view built from an older source snapshot
# group: [materialized_view]

statement ok con1
CREATE TABLE source(v INTEGER)

statement ok con1
INSERT INTO source VALUES (10)

statement ok con1
CREATE MATERIALIZED VIEW mv AS SELECT v FROM source

statement ok con1
BEGIN

query I con1
SELECT * FROM source
----
10

statement ok con2
UPDATE source SET v=30

statement ok con1
REFRESH MATERIALIZED VIEW mv

statement ok con1
COMMIT

statement ok con2
INSERT INTO source VALUES (40)

statement ok con1
REFRESH MATERIALIZED VIEW IF STALE mv

query I con1 rowsort
SELECT * FROM mv
----
30
40
