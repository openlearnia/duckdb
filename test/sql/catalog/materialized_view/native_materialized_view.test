# name: test/sql/catalog/materialized_view/native_materialized_view.test
# description: native DuckDB materialized view lifecycle and logical catalog discovery
# group: [materialized_view]

load __TEST_DIR__/native_materialized_view.db

statement ok
CREATE TABLE base(id INTEGER, grp INTEGER, val INTEGER)

statement ok
INSERT INTO base VALUES (1, 1, 10), (2, 1, 20), (3, 2, 5)

statement ok
CREATE MATERIALIZED VIEW mv AS
SELECT grp, sum(val) AS total
FROM base
GROUP BY grp

query II rowsort
SELECT * FROM mv
----
1	30
2	5

query T
SELECT table_type
FROM information_schema.tables
WHERE table_schema = 'main' AND table_name = 'mv'
----
MATERIALIZED VIEW

statement ok
INSERT INTO base VALUES (4, 2, 7)

query II rowsort
SELECT * FROM mv
----
1	30
2	5

statement ok
REFRESH MATERIALIZED VIEW mv

query II rowsort
SELECT * FROM mv
----
1	30
2	12

statement error
INSERT INTO mv VALUES (3, 99)
----
<REGEX>:.*materialized view.*

statement error
UPDATE mv SET total = 99
----
<REGEX>:.*materialized view.*

statement error
DELETE FROM mv
----
<REGEX>:.*materialized view.*

statement error
ALTER TABLE mv RENAME TO renamed_mv
----
<REGEX>:.*materialized view.*

statement error
DROP TABLE mv
----
<REGEX>:.*DROP MATERIALIZED VIEW.*

statement ok
REFRESH MATERIALIZED VIEW IF STALE mv

# A fresh IF STALE must not execute the defining query. The sequence makes that observable.
statement ok
CREATE SEQUENCE refresh_probe START 1

statement ok
CREATE MATERIALIZED VIEW mv_probe AS
SELECT id, nextval('refresh_probe') AS probe FROM base

query I
SELECT currval('refresh_probe')
----
4

statement ok
REFRESH MATERIALIZED VIEW IF STALE mv_probe

query I
SELECT currval('refresh_probe')
----
4

statement ok
INSERT INTO base VALUES (5, 3, 1)

statement ok
REFRESH MATERIALIZED VIEW IF STALE mv_probe

query I
SELECT currval('refresh_probe')
----
5

query TTTTI
SELECT schema_name, view_name,
       array_to_string(list_transform(dependencies, x -> regexp_extract(x, '[^.]+\.[^.]+$')), ','),
       last_refresh_mode, is_stale
FROM duckdb_materialized_views()
WHERE view_name = 'mv_probe'
----
main	mv_probe	main.base	append	false

statement ok
CHECKPOINT

restart

# Dependency generations and MV snapshots must agree after reopen.
query I
SELECT currval('refresh_probe')
----
6

statement ok
REFRESH MATERIALIZED VIEW IF STALE mv_probe

query I
SELECT currval('refresh_probe')
----
6

statement ok
DROP MATERIALIZED VIEW mv_probe

# Same-transaction creation predicts the generation that will commit.
statement ok
BEGIN

statement ok
CREATE TABLE base_txn(id INTEGER, val INTEGER)

statement ok
INSERT INTO base_txn VALUES (1, 10), (2, 20)

statement ok
CREATE MATERIALIZED VIEW mv_txn AS SELECT sum(val) AS total FROM base_txn

query I
SELECT is_stale FROM duckdb_materialized_views() WHERE view_name = 'mv_txn'
----
false

statement ok
COMMIT

query I
SELECT is_stale FROM duckdb_materialized_views() WHERE view_name = 'mv_txn'
----
false

# Uncommitted changes are stale to their own transaction, but rollback does not advance the generation.
statement ok
BEGIN

statement ok
UPDATE base_txn SET val = 99 WHERE id = 1

query I
SELECT is_stale FROM duckdb_materialized_views() WHERE view_name = 'mv_txn'
----
true

statement ok
ROLLBACK

query I
SELECT is_stale FROM duckdb_materialized_views() WHERE view_name = 'mv_txn'
----
false

statement ok
UPDATE base_txn SET val = 11 WHERE id = 1

query I
SELECT is_stale FROM duckdb_materialized_views() WHERE view_name = 'mv_txn'
----
true

statement ok
REFRESH MATERIALIZED VIEW IF STALE mv_txn

query II
SELECT total, is_stale
FROM mv_txn, duckdb_materialized_views()
WHERE view_name = 'mv_txn'
----
31	false

statement ok
DELETE FROM base_txn WHERE id = 2

query I
SELECT is_stale FROM duckdb_materialized_views() WHERE view_name = 'mv_txn'
----
true

statement ok
DROP MATERIALIZED VIEW mv_txn

# Projection MVs append only the new base rows.
statement ok
CREATE TABLE base_projection(id INTEGER, payload VARCHAR)

statement ok
INSERT INTO base_projection VALUES (1, 'one'), (2, 'two')

statement ok
CREATE MATERIALIZED VIEW mv_projection AS
SELECT id, upper(payload) AS payload FROM base_projection

statement ok
INSERT INTO base_projection VALUES (3, 'three'), (4, 'four')

statement ok
REFRESH MATERIALIZED VIEW IF STALE mv_projection

query IT rowsort
SELECT * FROM mv_projection
----
1	ONE
2	TWO
3	THREE
4	FOUR

query T
SELECT last_refresh_mode FROM duckdb_materialized_views() WHERE view_name = 'mv_projection'
----
append

# A second IF STALE is a no-op and must not duplicate appended rows.
statement ok
REFRESH MATERIALIZED VIEW IF STALE mv_projection

query I
SELECT count(*) FROM mv_projection
----
4

# Supported grouped aggregates merge an exact delta, including nulls and new groups.
statement ok
CREATE TABLE base_aggregate(grp INTEGER, val INTEGER)

statement ok
INSERT INTO base_aggregate VALUES (1, 10), (1, NULL), (2, 5)

statement ok
CREATE MATERIALIZED VIEW mv_aggregate AS
SELECT grp, count(*) AS rows, count(val) AS values, sum(val) AS total, min(val) AS minimum, max(val) AS maximum
FROM base_aggregate GROUP BY grp

statement ok
INSERT INTO base_aggregate VALUES (1, 20), (1, NULL), (2, 3), (3, NULL), (3, 7)

statement ok
REFRESH MATERIALIZED VIEW IF STALE mv_aggregate

query IIIIII rowsort
SELECT * FROM mv_aggregate
----
1	4	2	30	10	20
2	2	2	8	3	5
3	2	1	7	7	7

query T
SELECT last_refresh_mode FROM duckdb_materialized_views() WHERE view_name = 'mv_aggregate'
----
delta

# Updates and deletes invalidate append-only maintenance and force exact full refreshes.
statement ok
UPDATE base_aggregate SET val = 11 WHERE grp = 1 AND val = 10

statement ok
REFRESH MATERIALIZED VIEW IF STALE mv_aggregate

query T
SELECT last_refresh_mode FROM duckdb_materialized_views() WHERE view_name = 'mv_aggregate'
----
full

query IIIIII rowsort
SELECT * FROM mv_aggregate
----
1	4	2	31	11	20
2	2	2	8	3	5
3	2	1	7	7	7

statement ok
DELETE FROM base_aggregate WHERE grp = 2 AND val = 5

statement ok
REFRESH MATERIALIZED VIEW IF STALE mv_aggregate

query T
SELECT last_refresh_mode FROM duckdb_materialized_views() WHERE view_name = 'mv_aggregate'
----
full

query IIIIII rowsort
SELECT * FROM mv_aggregate
----
1	4	2	31	11	20
2	1	1	3	3	3
3	2	1	7	7	7

# Incremental metadata survives checkpoint/reopen.
statement ok
CHECKPOINT

restart

statement ok
INSERT INTO base_aggregate VALUES (3, 9), (4, 2)

statement ok
REFRESH MATERIALIZED VIEW IF STALE mv_aggregate

query IIIIII rowsort
SELECT * FROM mv_aggregate
----
1	4	2	31	11	20
2	1	1	3	3	3
3	3	2	16	7	9
4	1	1	2	2	2

query T
SELECT last_refresh_mode FROM duckdb_materialized_views() WHERE view_name = 'mv_aggregate'
----
delta

statement ok
DROP MATERIALIZED VIEW mv_aggregate

statement ok
DROP MATERIALIZED VIEW mv_projection

statement ok
DROP MATERIALIZED VIEW mv

statement error
SELECT * FROM mv
----
<REGEX>:.*Catalog Error.*
