CreateProcedureStmt <- 'PROCEDURE' IfNotExists? QualifiedName Parens(ProcedureParameters?) 'RETURNS' Type 'LANGUAGE' Identifier SecurityModifier? 'AS' StringLiteral

ProcedureParameters <- List(ProcedureParameter)

ProcedureParameter <- ColId Type

SecurityModifier <- 'SECURITY' SecurityType

SecurityType <- 'INVOKER' / 'DEFINER'
